#!/usr/bin/env bash
# GPU local test config for APGD-CW (APGD-DLR discovery + C&W L∞ shrink).
#   cp scripts/gpu_test_apgd_cw.env.example scripts/gpu_test.env
#   bash ./scripts/cloud_gpu_test.sh
#
# Or one-shot without copying:
#   bash ./scripts/cloud_gpu_test.sh --env-file scripts/gpu_test_apgd_cw.env.example

export PERTURB_ATTACK_ALGORITHM="apgd_cw"
export PERTURB_GPU_PROFILE="on"

# 13s attack budget (15s validator timeout minus ~2s safety margin)
export PERTURB_ATTACK_BUDGET_MS="13000"
export PERTURB_ATTACK_EARLY_STOP="true"
export PERTURB_ATTACK_LOG="on"
export PERTURB_ATTACK_MAX_DIM="512"
export PERTURB_QUANTIZE_FINAL="true"

# Phase split: discovery 25% (~3.25s) | C&W shrink 65% (~8.45s) | snap ~8%
export APGD_CW_PHASE1_FRAC="0.25"
export APGD_CW_PHASE2_FRAC="0.65"

# APGD-DLR
export APGD_CW_MOMENTUM="0.75"
export APGD_CW_INIT_STEP="2.0"
export APGD_CW_CHECKPOINT_RHO="0.75"
export APGD_CW_PHASE1_STEPS="100"

# C&W binary-ε shrink
export APGD_CW_BINARY_LEVELS="12"
export APGD_CW_STEPS_PER_LEVEL="20"
