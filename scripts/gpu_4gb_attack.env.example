#!/usr/bin/env bash
# GTX 1050 Ti / 4GB VRAM — sourced for local ImageNet-100 tests or miner tuning.
#   bash ./scripts/run_imagenet100_local_test.sh --env-file scripts/gpu_4gb_attack.env.example --device cuda

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/gpu_attack.env.example"

export PERTURB_GPU_PROFILE="on"
export PERTURB_TIMEOUT_SECONDS="20"
export PERTURB_ATTACK_BUDGET_MS="16000"
export PERTURB_ATTACK_MAX_DIM="0"

# Fit 4GB VRAM: EfficientNetV2-L + attack buffers (~2.5-3.5GB total)
export PERTURB_ATTACK_STEPS="48"
export PERTURB_ATTACK_RESTARTS="3"
export PERTURB_SPARSE_TOPK="1024"
export PERTURB_SALIENCY_FRACTION="0.01"
export PERTURB_ATTACK_SHRINK_ITERS="20"
export PERTURB_PRUNE_CHUNKS="256"
export PERTURB_SPARSE_BUDGET_FRAC="0.08"
