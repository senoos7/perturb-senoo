#!/usr/bin/env bash
# GPU local test config (attack + scoring, no Bittensor wallet needed).
#   cp scripts/gpu_test.env.example scripts/gpu_test.env
#   bash ./scripts/cloud_gpu_test.sh
#
# Or point to another file:
#   bash ./scripts/cloud_gpu_test.sh --env-file scripts/miner.env

# Attack algorithm: sma_mi_fgsm (default) | apgd_cw | magi (stub)
export PERTURB_ATTACK_ALGORITHM="sma_mi_fgsm"

# GPU attack profile (auto-detects CUDA; force with PERTURB_GPU_PROFILE=on)
export PERTURB_GPU_PROFILE="on"

# Stop within ~12s on 15s validator timeout (80% default when GPU profile is on)
export PERTURB_ATTACK_BUDGET_MS="12000"
export PERTURB_ATTACK_EARLY_STOP="true"

# Attack progress logs: on (default) | verbose | off
export PERTURB_ATTACK_LOG="on"

# Downscale large images for attack loops (EfficientNet sees ~480px anyway)
# Set 0 to attack at full resolution (only needed for huge stress-test images)
export PERTURB_ATTACK_MAX_DIM="512"

# Cap sparse search to 25% of budget so MI-FGSM always gets time
export PERTURB_SPARSE_BUDGET_FRAC="0.25"

# Optional overrides (defaults below are tuned for ~15s validator timeout)
# export PERTURB_ATTACK_STEPS="80"
# export PERTURB_ATTACK_RESTARTS="5"
# export PERTURB_SPARSE_TOPK="2048"
# export PERTURB_SALIENCY_FRACTION="0.01"
# export PERTURB_ATTACK_SHRINK_ITERS="24"
# export PERTURB_PRUNE_CHUNKS="256"
# export PERTURB_QUANTIZE_FINAL="true"

# APGD-CW preset: cp scripts/gpu_test_apgd_cw.env.example scripts/gpu_test.env
