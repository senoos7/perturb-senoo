#!/usr/bin/env bash
# GPU local e2e test (no Bittensor wallet) — copy to scripts/miner.test.env (gitignored), then:
#   bash ./scripts/cloud_gpu_test.sh
#
# GPU test uses ImageNet-100 from local HF cache (see run_imagenet100_local_test.sh).
# Or one-shot without copying:
#   bash ./scripts/cloud_gpu_test.sh --env-file scripts/miner.test.env.example

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/gpu_attack.env.example"

# Switch algorithm for test runs:
# export PERTURB_ATTACK_ALGORITHM="magi"
# export PERTURB_ATTACK_ALGORITHM="apgd_cw"
