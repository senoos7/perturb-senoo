#!/usr/bin/env bash
# Cloudflare R2 credentials for challenge image upload (gitignored).
# Create R2 API token in Cloudflare dashboard:
#   R2 Object Storage -> Manage R2 API Tokens -> Create API token
# Grant Object Read & Write on bucket perturb-miner-challenge.
#
# Add to scripts/miner.env:
#   source "$SCRIPT_DIR/miner_r2.env"

export PERTURB_R2_UPLOAD_CHALLENGES="1"
export PERTURB_R2_ACCOUNT_ID="43a58cca8d9d52d2d1dd959ad0dbe56e"
export PERTURB_R2_ACCESS_KEY_ID="fa01b38e508e4873ceca193a9123b3af"
export PERTURB_R2_SECRET_ACCESS_KEY="0b130037cc5630a488c7518b48f255c9917c3e666417e60414f484f2a40b63af"
export PERTURB_R2_BUCKET="perturb-miner-challenge"
export PERTURB_R2_PREFIX="challenges/"

# Optional: override S3 endpoint (default https://<account_id>.r2.cloudflarestorage.com)
# export PERTURB_R2_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"

# Optional local copy on GPU server (disable if you only want R2):
# export PERTURB_SAVE_CHALLENGE_IMAGES="0"

# Background worker threads for decode/local-save/R2 (runs after attack returns).
# export PERTURB_CHALLENGE_PERSIST_WORKERS="2"
