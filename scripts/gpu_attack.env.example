#!/usr/bin/env bash
# Shared GPU attack tuning — sourced by production and test env files.
# Do not run directly; use miner.production.env.example or miner.test.env.example.

export PERTURB_GPU_PROFILE="on"

# Validator default timeout is 20s (perturbnet/constants.py PERTURB_TIMEOUT_SECONDS).
export PERTURB_TIMEOUT_SECONDS="20"
# ~16s attack budget — leave ~4s for b64 encode + network
export PERTURB_ATTACK_BUDGET_MS="16000"
export PERTURB_ATTACK_EARLY_STOP="true"
export PERTURB_ATTACK_LOG="on"

# Full-resolution attack (0 = no downscale). Production challenges are ImageNet-100
# (~160px short side, variable aspect); full-res is fast enough on GPU.
export PERTURB_ATTACK_MAX_DIM="0"

# Cap sparse search so MI-FGSM restarts get most of the budget (~1.3s at 16s budget)
export PERTURB_SPARSE_BUDGET_FRAC="0.08"

export PERTURB_QUANTIZE_FINAL="true"

# Untargeted loss: ce (default) | dlr (ratio-normalized, opt-in)
export PERTURB_ATTACK_LOSS="ce"

# --- Algorithm -----------------------------------------------------------
# sma_mi_fgsm (default) | apgd_cw | magi (stub)
export PERTURB_ATTACK_ALGORITHM="sma_mi_fgsm"

# SMA-MI-FGSM — A100 / fast GPU profile (uses extra budget for restarts + refine)
export PERTURB_ATTACK_STEPS="80"
export PERTURB_ATTACK_RESTARTS="6"
export PERTURB_SPARSE_TOPK="2048"
export PERTURB_SALIENCY_FRACTION="0.01"
export PERTURB_ATTACK_SHRINK_ITERS="28"
export PERTURB_PRUNE_CHUNKS="384"

# APGD-CW (only used when PERTURB_ATTACK_ALGORITHM=apgd_cw)
export APGD_CW_PHASE1_FRAC="0.25"
export APGD_CW_PHASE2_FRAC="0.20"
export APGD_CW_MOMENTUM="0.75"
export APGD_CW_INIT_STEP="2.0"
export APGD_CW_CHECKPOINT_RHO="0.75"
export APGD_CW_PHASE1_STEPS="100"
export APGD_CW_BINARY_LEVELS="12"
export APGD_CW_STEPS_PER_LEVEL="20"
