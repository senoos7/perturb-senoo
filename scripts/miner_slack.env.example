# Copy to scripts/miner_slack.env (gitignored) and fill in webhook URL.
#
# Create a Slack Incoming Webhook:
#   Slack app → Incoming Webhooks → Add to workspace → copy URL
#
# Start watcher (alongside miner on GPU server):
#   bash scripts/run_miner_slack_watch.sh
#
# Or with PM2:
#   pm2 start scripts/run_miner_slack_watch.sh --name perturb-slack-watch
#   pm2 save

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/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

# PM2 process name for the miner (must match run_miner.sh / pm2 list)
PM2_MINER_PROCESS=perturb-miner

# Alive ping every 30 min (0 = off)
SLACK_HEARTBEAT_SECONDS=1800

# Rolling stats digest every 10 min (0 = off)
SLACK_DIGEST_SECONDS=600
SLACK_DIGEST_WINDOW_SECONDS=600

# Minimum seconds between Slack posts (avoid bursts)
SLACK_MIN_POST_INTERVAL_SECONDS=2
