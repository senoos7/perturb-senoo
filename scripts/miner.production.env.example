#!/usr/bin/env bash
# Production GPU miner — copy to scripts/miner.env (gitignored), then:
#   bash ./scripts/run_miner.sh
#   bash ./scripts/run_miner.sh --foreground

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/gpu_attack.env.example"

# Required — hotkey NAME (folder under ~/.bittensor/wallets/<name>/hotkeys/), not SS58.
# List hotkeys: btcli wallet overview --wallet.name senoo
WALLET_NAME="senoo"
WALLET_HOTKEY="perturb-miner-001"
WALLET_HOTKEY_SS58="5HZHtbzVFMq2RaoCKX3D7nJAG4QA5tPPynMjq9Re7aFoJTt3"

# Network
NETUID="26"
NETWORK="finney"
SUBTENSOR_CHAIN_ENDPOINT=""

PYTHON_BIN="python3"
LOG_LEVEL="INFO"
MINER_PORT="9000"
MINER_EXTRA_ARGS=""

# Only accept validator challenges from these endpoints (comma-separated ip or ip:axon_port).
# Disabled in miner.py until real validator IP is confirmed — uncomment to enable:
# export MINER_VALIDATOR_IP_WHITELIST="63.142.193.28:31711"

# Save validator challenge images locally (decoded JPEG per task).
# export PERTURB_SAVE_CHALLENGE_IMAGES="1"
# export PERTURB_CHALLENGE_SAVE_DIR="data/challenges"

# Upload challenge images to Cloudflare R2 (recommended for production GPU server).
#   cp scripts/miner_r2.env.example scripts/miner_r2.env
#   edit credentials, then add to miner.env: source "$SCRIPT_DIR/miner_r2.env"
# Test: python3 scripts/test_r2_upload.py --env-file scripts/miner_r2.env

# Override attack vars here if needed, e.g.:
# export PERTURB_ATTACK_ALGORITHM="apgd_cw"

# Optional Slack alerts (see scripts/miner_slack.env.example):
#   cp scripts/miner_slack.env.example scripts/miner_slack.env
#   bash scripts/run_miner_slack_watch.sh
