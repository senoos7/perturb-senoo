#!/usr/bin/env bash
# CPU local testing — source from imagenet100_local_test or miner.test.env.
# Slow per image; use --max-rows 1-5 on a laptop.

export PERTURB_GPU_PROFILE="off"

# Local eval only: long attack budget (validator speed weight is 0 by default).
export PERTURB_TIMEOUT_SECONDS="300"
export PERTURB_ATTACK_BUDGET_MS="180000"
export PERTURB_ATTACK_EARLY_STOP="true"
export PERTURB_ATTACK_LOG="on"
export PERTURB_ATTACK_MAX_DIM="0"
export PERTURB_SPARSE_BUDGET_FRAC="0.05"
export PERTURB_QUANTIZE_FINAL="true"
export PERTURB_ATTACK_LOSS="ce"
export PERTURB_ATTACK_ALGORITHM="sma_mi_fgsm"

# Reduced search vs production GPU profile
export PERTURB_ATTACK_STEPS="24"
export PERTURB_ATTACK_RESTARTS="1"
export PERTURB_SPARSE_TOPK="256"
export PERTURB_SALIENCY_FRACTION="0.02"
export PERTURB_ATTACK_SHRINK_ITERS="12"
export PERTURB_PRUNE_CHUNKS="128"
